{% schema %}
{
  "name": "Purelane Proof",
  "tag": "section",
  "class": "section-proof",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Why it works"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tough on grime.<br>Gentle on everything else."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Every formula is built on plant-derived cleansers and essential oils. It behaves exactly like the cleaner you are used to, minus the things you never signed up for."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "See the ingredient list"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    { "type": "header", "content": "Slide 1" },
    { "type": "image_picker", "id": "slide_1_image", "label": "Image 1 (Overrides Icon)" },
    { "type": "text", "id": "slide_1_icon", "label": "Icon Class", "default": "p-kitchen" },
    { "type": "text", "id": "slide_1_name", "label": "Name", "default": "Kitchen cleaner" },
    { "type": "text", "id": "slide_1_note", "label": "Note", "default": "Foam lifts grease, no scrubbing" },
    { "type": "header", "content": "Slide 2" },
    { "type": "image_picker", "id": "slide_2_image", "label": "Image 2 (Overrides Icon)" },
    { "type": "text", "id": "slide_2_icon", "label": "Icon Class", "default": "p-tap" },
    { "type": "text", "id": "slide_2_name", "label": "Name", "default": "Tap & limescale" },
    { "type": "text", "id": "slide_2_note", "label": "Note", "default": "Melts hard water stains" },
    { "type": "header", "content": "Slide 3" },
    { "type": "image_picker", "id": "slide_3_image", "label": "Image 3 (Overrides Icon)" },
    { "type": "text", "id": "slide_3_icon", "label": "Icon Class", "default": "p-laundry" },
    { "type": "text", "id": "slide_3_name", "label": "Name", "default": "Laundry detergent" },
    { "type": "text", "id": "slide_3_note", "label": "Note", "default": "Tough on odour, soft on fabric" },
    { "type": "header", "content": "Slide 4" },
    { "type": "image_picker", "id": "slide_4_image", "label": "Image 4 (Overrides Icon)" },
    { "type": "text", "id": "slide_4_icon", "label": "Icon Class", "default": "p-toilet" },
    { "type": "text", "id": "slide_4_name", "label": "Name", "default": "Toilet cleaner" },
    { "type": "text", "id": "slide_4_note", "label": "Note", "default": "Kills 99.9% of germs" },
    { "type": "header", "content": "Slide 5" },
    { "type": "image_picker", "id": "slide_5_image", "label": "Image 5 (Overrides Icon)" },
    { "type": "text", "id": "slide_5_icon", "label": "Icon Class", "default": "p-floor" },
    { "type": "text", "id": "slide_5_name", "label": "Name", "default": "Floor cleaner" },
    { "type": "text", "id": "slide_5_note", "label": "Note", "default": "Neem powered, pet safe" },
    { "type": "header", "content": "Slide 6" },
    { "type": "image_picker", "id": "slide_6_image", "label": "Image 6 (Overrides Icon)" },
    { "type": "text", "id": "slide_6_icon", "label": "Icon Class", "default": "p-dish" },
    { "type": "text", "id": "slide_6_name", "label": "Name", "default": "Dishwash gel" },
    { "type": "text", "id": "slide_6_note", "label": "Note", "default": "Cuts grease, kind to hands" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "ring_text",
          "label": "Ring Text",
          "default": "99.9%"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Germ kill"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Tested against germs and bacteria"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Proof",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "ring_text": "99.9%",
            "title": "Germ kill",
            "description": "Tested against germs and bacteria"
          }
        },
        {
          "type": "stat",
          "settings": {
            "ring_text": "0%",
            "title": "Sulphates",
            "description": "No SLS, chlorine or parabens"
          }
        },
        {
          "type": "stat",
          "settings": {
            "ring_text": "100%",
            "title": "Plant based",
            "description": "Cleansers derived from plants"
          }
        },
        {
          "type": "stat",
          "settings": {
            "ring_text": "4.8",
            "title": "Rated",
            "description": "Across 8,000+ verified reviews"
          }
        }
      ]
    }
  ]
}
{% endschema %}

<section class="sec" id="proof" data-scene="3">
  <div class="wrap">
    <div class="glass sec-pad rv">
      <div class="proof">
        
        <div class="proof-l">
          <span class="kicker">{{ section.settings.kicker | escape }}</span>
          <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
          <p class="body-s" style="max-width:40ch">{{ section.settings.description | escape }}</p>
          {%- if section.settings.button_label != blank -%}
            <a class="btn btn-primary" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label | escape }}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
            </a>
          {%- endif -%}
        </div>
        
        <div class="glass-2 rot" id="rot" aria-hidden="true">
          <div class="frame">
            {%- if section.settings.slide_1_image != blank -%}
              <img src="{{ section.settings.slide_1_image | image_url: width: 200 }}" class="pimg on" style="object-fit:contain; width:auto; height: 164px;" data-name="{{ section.settings.slide_1_name | escape }}" data-note="{{ section.settings.slide_1_note | escape }}" loading="lazy" aria-label="{{ section.settings.slide_1_name | escape }}">
            {%- else -%}
              <span class="pimg {{ section.settings.slide_1_icon }} on" role="img" aria-label="{{ section.settings.slide_1_name | escape }}" data-name="{{ section.settings.slide_1_name | escape }}" data-note="{{ section.settings.slide_1_note | escape }}"></span>
            {%- endif -%}
            
            {%- if section.settings.slide_2_image != blank -%}
              <img src="{{ section.settings.slide_2_image | image_url: width: 200 }}" class="pimg" style="object-fit:contain; width:auto; height: 164px;" data-name="{{ section.settings.slide_2_name | escape }}" data-note="{{ section.settings.slide_2_note | escape }}" loading="lazy" aria-label="{{ section.settings.slide_2_name | escape }}">
            {%- else -%}
              <span class="pimg {{ section.settings.slide_2_icon }}" role="img" aria-label="{{ section.settings.slide_2_name | escape }}" data-name="{{ section.settings.slide_2_name | escape }}" data-note="{{ section.settings.slide_2_note | escape }}"></span>
            {%- endif -%}

            {%- if section.settings.slide_3_image != blank -%}
              <img src="{{ section.settings.slide_3_image | image_url: width: 200 }}" class="pimg" style="object-fit:contain; width:auto; height: 164px;" data-name="{{ section.settings.slide_3_name | escape }}" data-note="{{ section.settings.slide_3_note | escape }}" loading="lazy" aria-label="{{ section.settings.slide_3_name | escape }}">
            {%- else -%}
              <span class="pimg {{ section.settings.slide_3_icon }}" role="img" aria-label="{{ section.settings.slide_3_name | escape }}" data-name="{{ section.settings.slide_3_name | escape }}" data-note="{{ section.settings.slide_3_note | escape }}"></span>
            {%- endif -%}

            {%- if section.settings.slide_4_image != blank -%}
              <img src="{{ section.settings.slide_4_image | image_url: width: 200 }}" class="pimg" style="object-fit:contain; width:auto; height: 164px;" data-name="{{ section.settings.slide_4_name | escape }}" data-note="{{ section.settings.slide_4_note | escape }}" loading="lazy" aria-label="{{ section.settings.slide_4_name | escape }}">
            {%- else -%}
              <span class="pimg {{ section.settings.slide_4_icon }}" role="img" aria-label="{{ section.settings.slide_4_name | escape }}" data-name="{{ section.settings.slide_4_name | escape }}" data-note="{{ section.settings.slide_4_note | escape }}"></span>
            {%- endif -%}

            {%- if section.settings.slide_5_image != blank -%}
              <img src="{{ section.settings.slide_5_image | image_url: width: 200 }}" class="pimg" style="object-fit:contain; width:auto; height: 164px;" data-name="{{ section.settings.slide_5_name | escape }}" data-note="{{ section.settings.slide_5_note | escape }}" loading="lazy" aria-label="{{ section.settings.slide_5_name | escape }}">
            {%- else -%}
              <span class="pimg {{ section.settings.slide_5_icon }}" role="img" aria-label="{{ section.settings.slide_5_name | escape }}" data-name="{{ section.settings.slide_5_name | escape }}" data-note="{{ section.settings.slide_5_note | escape }}"></span>
            {%- endif -%}

            {%- if section.settings.slide_6_image != blank -%}
              <img src="{{ section.settings.slide_6_image | image_url: width: 200 }}" class="pimg" style="object-fit:contain; width:auto; height: 164px;" data-name="{{ section.settings.slide_6_name | escape }}" data-note="{{ section.settings.slide_6_note | escape }}" loading="lazy" aria-label="{{ section.settings.slide_6_name | escape }}">
            {%- else -%}
              <span class="pimg {{ section.settings.slide_6_icon }}" role="img" aria-label="{{ section.settings.slide_6_name | escape }}" data-name="{{ section.settings.slide_6_name | escape }}" data-note="{{ section.settings.slide_6_note | escape }}"></span>
            {%- endif -%}
          </div>
          <div class="cap">
            <b>{{ section.settings.slide_1_name | escape }}</b>
            <span>{{ section.settings.slide_1_note | escape }}</span>
          </div>
          <div class="dots">
            <i class="on"></i><i></i><i></i><i></i><i></i><i></i>
          </div>
        </div>

        <div class="glass-2 stats proof-stats" style="grid-column:1/-1">
          {%- for block in section.blocks -%}
            <div class="stat" {{ block.shopify_attributes }}>
              <div class="ring">{{ block.settings.ring_text | escape }}</div>
              <h5>{{ block.settings.title | escape }}</h5>
              <p>{{ block.settings.description | escape }}</p>
            </div>
          {%- endfor -%}
        </div>
        
      </div>
    </div>
  </div>
</section>
