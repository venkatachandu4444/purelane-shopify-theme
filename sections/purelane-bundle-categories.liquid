{% schema %}
{
  "name": "Bundle Categories",
  "tag": "section",
  "class": "section-bundle-categories",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bundle categories"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find the right bundle for you"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (Overrides Icon)"
        },
        {
          "type": "text",
          "id": "icon_class",
          "label": "Icon Class (e.g. p-kitchen, p-toilet)",
          "default": "p-kitchen"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Kitchen bundle"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Grease, dishes & more"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Screen Reader Text",
          "default": "Purelane bundle"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bundle Categories",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "icon_class": "p-kitchen",
            "title": "Kitchen bundle",
            "description": "Grease, dishes & more",
            "alt_text": "Purelane foaming kitchen cleaner"
          }
        },
        {
          "type": "category",
          "settings": {
            "icon_class": "p-toilet",
            "title": "Bathroom bundle",
            "description": "Deep clean & disinfect",
            "alt_text": "Purelane non-toxic toilet cleaner"
          }
        },
        {
          "type": "category",
          "settings": {
            "icon_class": "p-laundry",
            "title": "Laundry bundle",
            "description": "Softer, fresher wash",
            "alt_text": "Purelane non-toxic laundry detergent"
          }
        },
        {
          "type": "category",
          "settings": {
            "icon_class": "p-tap",
            "title": "Hard water bundle",
            "description": "Melt away limescale",
            "alt_text": "Purelane tap cleaner and limescale remover"
          }
        }
      ]
    }
  ]
}
{% endschema %}

<section class="sec" id="categories" data-scene="4">
  <div class="wrap">
    <div class="panel-head rv">
      <span class="kicker">{{ section.settings.kicker | escape }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | escape }}</h2>
    </div>
    <div class="cats">
      {%- for block in section.blocks -%}
        {%- assign delay_class = "" -%}
        {%- if forloop.index == 2 -%}{%- assign delay_class = "rv-d1" -%}
        {%- elsif forloop.index == 3 -%}{%- assign delay_class = "rv-d2" -%}
        {%- elsif forloop.index == 4 -%}{%- assign delay_class = "rv-d3" -%}{%- endif -%}
        
        <a class="glass cat rv {{ delay_class }}" href="{{ block.settings.link | default: '#combos' }}" {{ block.shopify_attributes }}>
          <span class="ph">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: height: 160 }}" alt="{{ block.settings.alt_text | escape }}" class="pimg" style="object-fit: contain; width: auto; max-height: 120px;" loading="lazy">
            {%- else -%}
              <span class="pimg {{ block.settings.icon_class | escape }}" role="img" aria-label="{{ block.settings.alt_text | escape }}"></span>
            {%- endif -%}
          </span>
          <span class="txt">
            <h4>{{ block.settings.title | escape }}</h4>
            <p>{{ block.settings.description | escape }}</p>
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
