{% schema %}
{
  "name": "Bundles",
  "tag": "section",
  "class": "section-bundles",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Build your bundle"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One box. Every room."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way."
    }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Bundle Tier",
      "limit": 3,
      "settings": [
        {
          "type": "checkbox",
          "id": "is_best",
          "label": "Highlight as Most Popular",
          "default": false
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag Text",
          "default": "Starter"
        },
        {
          "type": "text",
          "id": "qty",
          "label": "Quantity (Number)",
          "default": "2"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "₹349"
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Compare Price",
          "default": "₹598"
        },
        {
          "type": "text",
          "id": "cost_per_product",
          "label": "Cost Per Product Note",
          "default": "Flat ₹174 per product"
        },
        {
          "type": "text",
          "id": "bullet_1",
          "label": "Bullet 1",
          "default": "Pick any two products"
        },
        {
          "type": "text",
          "id": "bullet_2",
          "label": "Bullet 2",
          "default": "Free shipping across India"
        },
        {
          "type": "text",
          "id": "bullet_3",
          "label": "Bullet 3"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Build this box"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        },
        {
          "type": "header",
          "content": "Images (CSS Classes)"
        },
        {
          "type": "checkbox",
          "id": "use_five_layout",
          "label": "Use 5-Image Layout",
          "default": false
        },
        {
          "type": "image_picker",
          "id": "image_1",
          "label": "Image 1 (Overrides Icon)"
        },
        {
          "type": "text",
          "id": "icon_1",
          "label": "Icon 1 Class",
          "default": "p-combo2"
        },
        {
          "type": "image_picker",
          "id": "image_2",
          "label": "Image 2 (Overrides Icon)"
        },
        {
          "type": "text",
          "id": "icon_2",
          "label": "Icon 2 Class"
        },
        {
          "type": "image_picker",
          "id": "image_3",
          "label": "Image 3 (Overrides Icon)"
        },
        {
          "type": "text",
          "id": "icon_3",
          "label": "Icon 3 Class"
        },
        {
          "type": "image_picker",
          "id": "image_4",
          "label": "Image 4 (Overrides Icon)"
        },
        {
          "type": "text",
          "id": "icon_4",
          "label": "Icon 4 Class"
        },
        {
          "type": "image_picker",
          "id": "image_5",
          "label": "Image 5 (Overrides Icon)"
        },
        {
          "type": "text",
          "id": "icon_5",
          "label": "Icon 5 Class"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bundles",
      "blocks": [
        {
          "type": "tier",
          "settings": {
            "is_best": false,
            "tag": "Starter",
            "qty": "2",
            "price": "₹349",
            "compare_price": "₹598",
            "cost_per_product": "Flat ₹174 per product",
            "bullet_1": "Pick any two products",
            "bullet_2": "Free shipping across India",
            "bullet_3": "",
            "button_label": "Build this box",
            "icon_1": "p-combo2"
          }
        },
        {
          "type": "tier",
          "settings": {
            "is_best": true,
            "tag": "Most popular",
            "qty": "3",
            "price": "₹499",
            "compare_price": "₹897",
            "cost_per_product": "Flat ₹166 per product",
            "bullet_1": "Pick any three products",
            "bullet_2": "Covers kitchen and laundry",
            "bullet_3": "Free shipping across India",
            "button_label": "Build this box",
            "icon_1": "p-kitchen",
            "icon_2": "p-tap",
            "icon_3": "p-dish"
          }
        },
        {
          "type": "tier",
          "settings": {
            "is_best": false,
            "tag": "Whole home",
            "qty": "5",
            "price": "₹799",
            "compare_price": "₹1495",
            "cost_per_product": "Flat ₹160 per product",
            "bullet_1": "Pick any five products",
            "bullet_2": "Every room in one order",
            "bullet_3": "Free shipping across India",
            "button_label": "Build this box",
            "use_five_layout": true,
            "icon_1": "p-kitchen",
            "icon_2": "p-tap",
            "icon_3": "p-floor",
            "icon_4": "p-toilet",
            "icon_5": "p-laundry"
          }
        }
      ]
    }
  ]
}
{% endschema %}

<section class="sec" id="bundles" data-scene="3">
  <div class="wrap">
    <div class="glass sec-pad rv" style="margin-bottom:16px">
      <div class="panel-head" style="margin-bottom:0">
        <span class="kicker">{{ section.settings.kicker | escape }}</span>
        <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | escape }}</h2>
        <p class="lede" style="margin:0 auto">{{ section.settings.description | escape }}</p>
      </div>
    </div>
    <div class="tiers">
      {%- for block in section.blocks -%}
        <article class="glass tier {% if block.settings.is_best %}best{% endif %} rv {% if forloop.index == 2 %}rv-d2{% elsif forloop.index == 3 %}rv-d3{% endif %}" {{ block.shopify_attributes }}>
          <span class="tag">{{ block.settings.tag | escape }}</span>
          <div class="tierpix {% if block.settings.use_five_layout %}five{% endif %}" aria-hidden="true">
            {%- if block.settings.image_1 != blank -%}
              <img src="{{ block.settings.image_1 | image_url: height: 80 }}" alt="{{ block.settings.image_1.alt | escape }}" style="height: 48px; width: auto; object-fit: contain;">
            {%- elsif block.settings.icon_1 != blank -%}
              <span class="pimg {{ block.settings.icon_1 | escape }}" role="img"></span>
            {%- endif -%}

            {%- if block.settings.image_2 != blank -%}
              <img src="{{ block.settings.image_2 | image_url: height: 80 }}" alt="{{ block.settings.image_2.alt | escape }}" style="height: 48px; width: auto; object-fit: contain;">
            {%- elsif block.settings.icon_2 != blank -%}
              <span class="pimg {{ block.settings.icon_2 | escape }}" role="img"></span>
            {%- endif -%}

            {%- if block.settings.image_3 != blank -%}
              <img src="{{ block.settings.image_3 | image_url: height: 80 }}" alt="{{ block.settings.image_3.alt | escape }}" style="height: 48px; width: auto; object-fit: contain;">
            {%- elsif block.settings.icon_3 != blank -%}
              <span class="pimg {{ block.settings.icon_3 | escape }}" role="img"></span>
            {%- endif -%}

            {%- if block.settings.image_4 != blank -%}
              <img src="{{ block.settings.image_4 | image_url: height: 80 }}" alt="{{ block.settings.image_4.alt | escape }}" style="height: 48px; width: auto; object-fit: contain;">
            {%- elsif block.settings.icon_4 != blank -%}
              <span class="pimg {{ block.settings.icon_4 | escape }}" role="img"></span>
            {%- endif -%}

            {%- if block.settings.image_5 != blank -%}
              <img src="{{ block.settings.image_5 | image_url: height: 80 }}" alt="{{ block.settings.image_5.alt | escape }}" style="height: 48px; width: auto; object-fit: contain;">
            {%- elsif block.settings.icon_5 != blank -%}
              <span class="pimg {{ block.settings.icon_5 | escape }}" role="img"></span>
            {%- endif -%}
          </div>
          <div class="qty">{{ block.settings.qty | escape }}<small>Products</small></div>
          <div class="price">{{ block.settings.price | escape }} <s>{{ block.settings.compare_price | escape }}</s></div>
          <p class="body-s" style="font-size:12px">{{ block.settings.cost_per_product | escape }}</p>
          <ul>
            {%- if block.settings.bullet_1 != blank -%}
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>{{ block.settings.bullet_1 | escape }}</li>
            {%- endif -%}
            {%- if block.settings.bullet_2 != blank -%}
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>{{ block.settings.bullet_2 | escape }}</li>
            {%- endif -%}
            {%- if block.settings.bullet_3 != blank -%}
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>{{ block.settings.bullet_3 | escape }}</li>
            {%- endif -%}
          </ul>
          <a class="btn {% if block.settings.is_best %}btn-primary{% else %}btn-ghost{% endif %}" href="{{ block.settings.button_link | default: '#shop' }}">
            {{ block.settings.button_label | escape }}
            {%- if block.settings.is_best -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
            {%- endif -%}
          </a>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>
