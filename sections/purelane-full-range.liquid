{% schema %}
{
  "name": "Full Range",
  "tag": "section",
  "class": "section-full-range",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "The full range"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Every room, one shelf"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Floors, taps, kitchen, laundry, bathroom and hands. Fourteen plant-based formulas that replace every harsh bottle under your sink."
    },
    {
      "type": "text",
      "id": "swipe_hint",
      "label": "Swipe Hint Text",
      "default": "Swipe to see the full shelf"
    }
  ],
  "blocks": [
    {
      "type": "bottle",
      "name": "Bottle",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (Overrides Icon)"
        },
        {
          "type": "text",
          "id": "icon_class",
          "label": "Icon Class (e.g. p-floor, p-tap)",
          "default": "p-floor"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Screen Reader Text",
          "default": "Purelane cleaner"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Full Range",
      "blocks": [
        { "type": "bottle", "settings": { "icon_class": "p-floor", "alt_text": "Purelane natural herbal floor cleaner" } },
        { "type": "bottle", "settings": { "icon_class": "p-tap", "alt_text": "Purelane tap cleaner and limescale remover" } },
        { "type": "bottle", "settings": { "icon_class": "p-kitchen", "alt_text": "Purelane foaming kitchen cleaner" } },
        { "type": "bottle", "settings": { "icon_class": "p-toilet", "alt_text": "Purelane non-toxic toilet cleaner" } },
        { "type": "bottle", "settings": { "icon_class": "p-laundry", "alt_text": "Purelane natural laundry detergent" } },
        { "type": "bottle", "settings": { "icon_class": "p-dish", "alt_text": "Purelane organic dishwash liquid gel" } },
        { "type": "bottle", "settings": { "icon_class": "p-metal", "alt_text": "Purelane copper, bronze and brass cleaner" } },
        { "type": "bottle", "settings": { "icon_class": "p-wm", "alt_text": "Purelane washing machine cleaner and descaler" } },
        { "type": "bottle", "settings": { "icon_class": "p-handwash", "alt_text": "Purelane gentle hydrating liquid handwash" } },
        { "type": "bottle", "settings": { "icon_class": "p-eraser", "alt_text": "Purelane magic eraser" } }
      ]
    }
  ]
}
{% endschema %}

<section class="sec" id="range" data-scene="4">
  <div class="wrap">
    <div class="glass range rv">
      <div class="range-head">
        <div>
          <span class="kicker">{{ section.settings.kicker | escape }}</span>
          <h2 class="d2" style="margin-top:10px">{{ section.settings.heading | escape }}</h2>
        </div>
        <p class="body-s" style="max-width:34ch;margin-bottom:4px">{{ section.settings.description | escape }}</p>
      </div>
      <div class="stripwrap">
        <div class="rangerow">
          {%- for block in section.blocks -%}
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: height: 180 }}" alt="{{ block.settings.alt_text | escape }}" class="pimg" style="object-fit: contain; width: auto;" {{ block.shopify_attributes }} loading="lazy">
            {%- else -%}
              <span class="pimg {{ block.settings.icon_class | escape }}" role="img" aria-label="{{ block.settings.alt_text | escape }}" {{ block.shopify_attributes }}></span>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
      <p class="striphint">{{ section.settings.swipe_hint | escape }}</p>
    </div>
  </div>
</section>
