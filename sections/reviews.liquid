{% schema %}
{
  "name": "Reviews Rail",
  "tag": "section",
  "class": "section-reviews",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "That's what they said"
    },
    {
      "type": "text",
      "id": "rating_score",
      "label": "Rating Score",
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "reviews_count_text",
      "label": "Reviews Count Text",
      "default": "from 8,000+ reviews"
    },
    {
      "type": "text",
      "id": "homes_count_text",
      "label": "Homes Count Text",
      "default": "Loved by <b>12 lakh+</b> homes"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5,
          "label": "Star Rating"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Review Heading",
          "default": "Works like a charm"
        },
        {
          "type": "textarea",
          "id": "review_text",
          "label": "Review Text",
          "default": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better."
        },
        {
          "type": "text",
          "id": "reviewer_name",
          "label": "Reviewer Name",
          "default": "Anita"
        },
        {
          "type": "text",
          "id": "product_mentioned",
          "label": "Product Mentioned",
          "default": "Laundry detergent"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews Rail",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "heading": "Works like a charm",
            "review_text": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better.",
            "reviewer_name": "Anita",
            "product_mentioned": "Laundry detergent"
          }
        },
        {
          "type": "review",
          "settings": {
            "heading": "Best dishwash ever",
            "review_text": "Our old dishwash left my help with dry, cracked skin. That stopped completely after we switched.",
            "reviewer_name": "Priya",
            "product_mentioned": "Dishwash gel"
          }
        },
        {
          "type": "review",
          "settings": {
            "heading": "Great product, great packaging",
            "review_text": "Very soft on hands with a lovely fragrance, and it feels good to be using far less plastic.",
            "reviewer_name": "Sunita",
            "product_mentioned": "Liquid handwash"
          }
        },
        {
          "type": "review",
          "settings": {
            "heading": "Dog friendly",
            "review_text": "We switched because chemical floor cleaners were setting off my dog's allergies. No reactions since.",
            "reviewer_name": "Rohit S.",
            "product_mentioned": "Floor cleaner"
          }
        },
        {
          "type": "review",
          "settings": {
            "heading": "Sparkling taps again",
            "review_text": "Hard water had ruined our bathroom fittings. Two sprays and the scale wipes straight off, no scrubbing.",
            "reviewer_name": "Verified buyer",
            "product_mentioned": "Tap cleaner"
          }
        }
      ]
    }
  ]
}
{% endschema %}

<section class="sec revband" id="reviews" data-scene="1">
  <div class="wrap">
    <div class="revhead rv">
      <span class="kicker">{{ section.settings.kicker | escape }}</span>
      <span class="agg">
        <span class="st">&#9733;&#9733;&#9733;&#9733;&#9733;</span> 
        <b>{{ section.settings.rating_score | escape }}</b> 
        {{ section.settings.reviews_count_text | escape }}
      </span>
      <span class="agg">{{ section.settings.homes_count_text }}</span>
    </div>
  </div>
  
  <div class="revrail rv" aria-label="Customer reviews">
    <div class="revtrack">
      {%- if section.blocks.size > 0 -%}
        {%- for i in (1..4) -%}
          {%- for block in section.blocks -%}
            {% render 'review-card', block: block %}
          {%- endfor -%}
        {%- endfor -%}
      {%- else -%}
        <article class="glass-2 rcard">
          <div class="st">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
          <h5>Add reviews</h5>
          <p>Use the Theme Editor to add review blocks to this section.</p>
          <div class="who">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
            <b>Store Admin</b>
          </div>
        </article>
      {%- endif -%}
    </div>
  </div>
</section>
